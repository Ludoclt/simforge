struct {{MODULE_PASCAL}}InData : public sfuvm::InputData
{
    // TODO: replace with real input fields
    uint8_t data_in = 0;

    {{MODULE_PASCAL}}InData() = default;
    explicit {{MODULE_PASCAL}}InData(uint8_t data) : data_in(data) {}

    bool operator==(const {{MODULE_PASCAL}}InData &o) const { return data_in == o.data_in; }
    bool operator!=(const {{MODULE_PASCAL}}InData &o) const { return !(*this == o); }
};

struct {{MODULE_PASCAL}}OutData : public sfuvm::OutputData
{
    // TODO: replace with real output fields
    uint8_t data_out = 0;

    {{MODULE_PASCAL}}OutData() = default;
    explicit {{MODULE_PASCAL}}OutData(uint8_t data) : data_out(data) {}

    bool operator==(const {{MODULE_PASCAL}}OutData &o) const { return data_out == o.data_out; }
    bool operator!=(const {{MODULE_PASCAL}}OutData &o) const { return !(*this == o); }
};
