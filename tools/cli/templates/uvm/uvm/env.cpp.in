#include "{{MODULE}}_env.hpp"

// Include all UVM components so the compiler sees their definitions
#include "../uvm/{{MODULE}}_uvm.hpp"

void {{MODULE_PASCAL}}Env::build_phase()
{
    auto &agent = emplace_component<sfuvma::Agent<{{MODULE_PASCAL}}Vif>>(this, "MAIN AGENT");

    agent.sequencer = &emplace_component<{{MODULE_PASCAL}}Sequencer>(&agent, "{{MODULE_UPPER}} SEQ");
    agent.driver    = &emplace_component<{{MODULE_PASCAL}}Driver>   (&agent, "{{MODULE_UPPER}} DRV");

    agent.monitors.push_back(&emplace_component<{{MODULE_PASCAL}}InputMonitor> (&agent, "{{MODULE_UPPER}} IN MON"));
    agent.monitors.push_back(&emplace_component<{{MODULE_PASCAL}}OutputMonitor>(&agent, "{{MODULE_UPPER}} OUT MON"));

    emplace_component<{{MODULE_PASCAL}}Scoreboard>(this);
    emplace_component<{{MODULE_PASCAL}}Coverage>  (this);

    sfuvmc::Env::build_phase();
}
