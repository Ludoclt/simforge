        analysis_port.connect(&env.template get_scb<{{MODULE_PASCAL}}Scoreboard>().out_export);
        analysis_port.connect(&env.template get_cov<{{MODULE_PASCAL}}Coverage>().out_export);
    }

    bool should_sample() const override
    {
        return clk().posedge() && !rst().is_asserted();
    }

    Tx sample() override
    {
        // TODO: return nullptr to skip this cycle
        return std::make_shared<{{MODULE_PASCAL}}OutData>(/* TODO: capture fields */);
    }
};
