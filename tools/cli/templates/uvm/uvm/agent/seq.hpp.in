#pragma once

#include "../../{{MODULE}}_defs.hpp"
#include "../../{{MODULE}}_data.hpp"

class {{MODULE_PASCAL}}Sequencer : public sfuvma::Sequencer
{
public:
    using sfuvma::Sequencer::Sequencer;

    void build_phase() override
    {
        // Random stimulus
        for (size_t i = 0; i < 20; ++i)
        {
            auto tx = std::make_shared<{{MODULE_PASCAL}}InData>(
                static_cast<uint8_t>(random_stimuli(8)));
            tx->time_offset = random_stimuli_range(0, 4);
            sequence.put(std::move(tx));
        }

        // Corner cases
        for (uint8_t corner : {0x00, 0x01, 0x7F, 0x80, 0xFF})
        {
            sequence.put(std::make_shared<{{MODULE_PASCAL}}InData>(corner));
        }
    }

    void on_reset() override {}
};
