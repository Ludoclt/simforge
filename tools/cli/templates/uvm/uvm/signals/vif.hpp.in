{
    // Inputs (written by driver)
{{VIF_INPUT_FIELDS}}
    // Outputs (read by monitors)
{{VIF_OUTPUT_FIELDS}}
    {{MODULE_PASCAL}}Vif()
{{VIF_CTOR_INIT}}
    {}
};
