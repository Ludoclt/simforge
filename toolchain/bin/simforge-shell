#!/usr/bin/env bash

set -euo pipefail

# --- Find SIMFORGE_TOOLCHAIN_DIR and PROJECT_ROOT ---

SIMFORGE_TOOLCHAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PROJECT_ROOT=""
search_dir="$SIMFORGE_TOOLCHAIN_DIR"
while [ "$search_dir" != "/" ]; do
    if [ -f "$search_dir/.simforge.env" ]; then
        PROJECT_ROOT="$search_dir"
        break
    fi
    search_dir="$(dirname "$search_dir")"
done

if [ -z "$PROJECT_ROOT" ]; then
    echo "[simforge] Error: could not find .simforge.env in any parent directory."
    exit 1
fi

ENV_FILE="$PROJECT_ROOT/.simforge.env"
# shellcheck source=/dev/null
source "$ENV_FILE"

IMAGE_NAME="${PROJECT_NAME:-simforge}-toolchain"

# --- Check image exists ---

if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
    echo "[simforge] Image '$IMAGE_NAME' not found. Run 'simforge-build' first."
    exit 1
fi

# --- Run ---

echo "[simforge] Starting toolchain shell (container will be removed on exit)..."
echo ""

xhost +local:docker 2>/dev/null || true

docker run --rm -it \
    --name "${IMAGE_NAME}-session" \
    -v "$PROJECT_ROOT":/project \
    -e DISPLAY="$DISPLAY" \
    -v /tmp/.X11-unix:/tmp/.X11-unix \
    -w /project \
    "$IMAGE_NAME" \
    /bin/bash
