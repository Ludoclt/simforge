#!/usr/bin/env bash

set -euo pipefail

# --- Find SIMFORGE_TOOLCHAIN_DIR and PROJECT_ROOT ---

SIMFORGE_TOOLCHAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PROJECT_ROOT=""
search_dir="$SIMFORGE_TOOLCHAIN_DIR"
while [ "$search_dir" != "/" ]; do
    if [ -f "$search_dir/.simforge.env" ]; then
        PROJECT_ROOT="$search_dir"
        break
    fi
    search_dir="$(dirname "$search_dir")"
done

if [ -z "$PROJECT_ROOT" ]; then
    echo "[simforge] Error: could not find .simforge.env in any parent directory."
    exit 1
fi

ENV_FILE="$PROJECT_ROOT/.simforge.env"
# shellcheck source=/dev/null
source "$ENV_FILE"

IMAGE_NAME="${PROJECT_NAME:-simforge}-toolchain"

# --- Build ---

echo "[simforge] Building image: $IMAGE_NAME"
echo "[simforge] Context: $SIMFORGE_TOOLCHAIN_DIR/.."
echo ""

docker build \
    --tag "$IMAGE_NAME" \
    --build-arg USER_UID="$(id -u)" \
    --build-arg USER_GID="$(id -g)" \
    --file "$SIMFORGE_TOOLCHAIN_DIR/Dockerfile" \
    "$SIMFORGE_TOOLCHAIN_DIR/.."

echo ""
echo "[simforge] Image '$IMAGE_NAME' built successfully."
